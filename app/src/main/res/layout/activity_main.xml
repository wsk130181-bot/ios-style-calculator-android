<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvPending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|bottom"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="10dp"
        android:textColor="#66FFFFFF"
        android:textSize="26sp"
        android:text=""
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="end|bottom"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFF"
        android:textSize="76sp"
        android:text="0"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 第 1 行：AC ± % ÷ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAC"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_fn"
            android:text="AC"
            android:textColor="#000000"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="AC"
            android:onClick="onKey" />

        <Button
            android:id="@+id/btnNeg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_fn"
            android:text="±"
            android:textColor="#000000"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="±"
            android:onClick="onKey" />

        <Button
            android:id="@+id/btnPct"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_fn"
            android:text="%"
            android:textColor="#000000"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="%"
            android:onClick="onKey" />

        <Button
            android:id="@+id/btnDiv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_op"
            android:text="÷"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="÷"
            android:onClick="onKey" />
    </LinearLayout>

    <!-- 第 2 行：7 8 9 × -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_num"
            android:text="7"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="7"
            android:onClick="onKey" />

        <Button
            android:id="@+id/btn8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_num"
            android:text="8"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="8"
            android:onClick="onKey" />

        <Button
            android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_num"
            android:text="9"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="9"
            android:onClick="onKey" />

        <Button
            android:id="@+id/btnMul"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_op"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="×"
            android:onClick="onKey" />
    </LinearLayout>

    <!-- 第 3 行：4 5 6 − -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_num"
            android:text="4"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="4"
            android:onClick="onKey" />

        <Button
            android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_num"
            android:text="5"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="5"
            android:onClick="onKey" />

        <Button
            android:id="@+id/btn6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_num"
            android:text="6"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="6"
            android:onClick="onKey" />

        <Button
            android:id="@+id/btnSub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_op"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="−"
            android:onClick="onKey" />
    </LinearLayout>

    <!-- 第 4 行：1 2 3 + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_num"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="1"
            android:onClick="onKey" />

        <Button
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_num"
            android:text="2"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="2"
            android:onClick="onKey" />

        <Button
            android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_num"
            android:text="3"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="3"
            android:onClick="onKey" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_op"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="+"
            android:onClick="onKey" />
    </LinearLayout>

    <!-- 第 5 行：0(宽) . = -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_margin="4dp"
            android:background="@drawable/btn_num_wide"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="0"
            android:onClick="onKey" />

        <Button
            android:id="@+id/btnDot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_num"
            android:text="."
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="."
            android:onClick="onKey" />

        <Button
            android:id="@+id/btnEq"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_op"
            android:text="="
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:tag="="
            android:onClick="onKey" />
    </LinearLayout>
</LinearLayout>
